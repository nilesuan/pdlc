# Start from settings.example.json; keep your own permission posture here.
/settings.json
/settings.local.json
/.claude.json

# Live persistent memory - user-owned, never committed. Memory files hold
# machine-specific and private detail (hostnames, account identifiers,
# resource IDs). Start from MEMORY.example.md.
/MEMORY.md
/memory/

# Generated artifacts and pipeline state
cdocs/
.pipeline.json

# Local audit log target (see settings env PDLC_AUDIT_LOG)
.pdlc/
